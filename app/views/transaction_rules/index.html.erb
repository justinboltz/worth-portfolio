<div class="page-heading"><div><p class="eyebrow">CATEGORIZE IT YOUR WAY</p><h1>Transaction rules</h1><p>Keep recurring transactions organized with rules you control.</p></div><%= link_to 'Back to transactions', transactions_path, class: 'secondary-button' %></div>
<%= render 'shared/list_search', destination: transaction_rules_path, placeholder: 'Description, account, category or tags', choices: %w[regular transfer card_payment hidden].map { |kind| [kind.humanize, kind] } %>
<%= render 'shared/form_errors', record: @draft %>
<details class="card padded creation-panel" <%= 'open' if @draft.persisted? || @draft.errors.any? || @preview_transactions || @rules.empty? %>><summary><%= @draft.persisted? ? 'Edit rule' : 'Create a rule' %></summary><%= render 'form', rule: @draft %></details>
<% if @preview_transactions %><section class="card padded"><h2>Preview · <%= pluralize(@match_count, "matching transaction") %></h2><p>No changes have been saved. <%= @protected_category_count %> matching transactions have saved category choices that will be preserved. Showing up to 10 matches.</p><div class="table-scroll"><table class="responsive-table" role="table" aria-label="Rule preview"><thead><tr><th scope="col">Date</th><th scope="col">Description</th><th scope="col">Account</th><th scope="col">Current category</th><th scope="col">Amount</th></tr></thead><tbody><% @preview_transactions.each do |t| %><tr><td data-label="Date"><%= t.date %></td><td data-label="Description"><%= t.name %></td><td data-label="Account"><%= t.account_label %></td><td data-label="Current category"><%= t.category&.display_name || 'Uncategorized' %></td><td data-label="Amount"><%= money(t.amount, t.iso_currency_code) %></td></tr><% end %></tbody></table></div></section><% end %>
<section class="card padded"><h2>Your rules</h2><p>Rules run in creation order; later category matches win. Manual and imported category choices are protected. Editing or deleting a rule preserves past edits unless you explicitly apply an edited rule to history.</p>
<% @rules.reject { |rule| @draft.persisted? && rule.id == @draft.id }.each do |r| %><div class="category-management"><div class="rule-details"><strong><% if r.merchant_key.present? %>Exact merchant “<%= r.match_text %>”<% elsif r.match_text.present? %>Description <%= TransactionRule::DESCRIPTION_OPERATORS[r.description_operator].downcase %> “<%= r.match_text %>”<% else %>All descriptions<% end %></strong><small><%= r.account ? "Account: #{r.account.name}#{r.account.mask.present? ? " · ending #{r.account.mask}" : ''}" : r.source_account_name.present? ? "Imported account: #{r.source_account_name}" : 'All accounts' %></small><small><%= r.category&.display_name || 'Keep category' %> · <%= r.kind == 'regular' ? 'No additional flag' : r.kind.humanize %> · <%= r.tags %></small><details class="editor-details"><summary aria-label="Edit rule: <%= r.match_text.presence || r.account&.name || r.source_account_name %>">Edit rule</summary><%= turbo_frame_tag dom_id(r, :editor), src: edit_transaction_rule_path(r), loading: :lazy, data: { controller: 'lazy-editor', action: 'turbo:frame-missing->lazy-editor#unavailable turbo:fetch-request-error->lazy-editor#unavailable' } do %><p class="status-message" role="status"></p><%= link_to 'Open rule editor', edit_transaction_rule_path(r), class: 'text-button', data: { turbo_frame: '_top' } %><% end %></details></div><%= button_to 'Delete rule', transaction_rule_path(r), method: :delete, class: 'danger-button', form: { data: { turbo_confirm: 'Delete this rule? Existing transaction categories and flags will be kept.' } } %></div><% end %><% if @rules.empty? %><p>No rules yet. For example: description contains “Kroger” → Groceries, or account is “Business checking” → Business expenses.</p><% end %></section>
