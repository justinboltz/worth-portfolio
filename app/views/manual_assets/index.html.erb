<div class="page-heading"><div><p class="eyebrow">MORE THAN YOUR BANK BALANCE</p><h1>Your assets</h1><p class="muted">Property, vehicles, and other things you own.</p></div><%= link_to "+ Add asset", new_manual_asset_path, class: "primary-button" %></div>
<%= render 'shared/list_search', destination: manual_assets_path, placeholder: 'Asset name or notes', choices: ManualAsset::TYPES.map { |key, label| [label, key] } %>
<section class="card"><div class="table-scroll"><table class="responsive-table" role="table" aria-label="Manual assets"><thead><tr><th scope="col">Asset</th><th scope="col">Type</th><th scope="col">Valued on</th><th scope="col" class="amount">Your share's value</th><th scope="col">Actions</th></tr></thead><tbody>
<% @assets.each do |asset| %><tr><td data-label="Asset"><strong><%= asset.name %></strong></td><td data-label="Type"><%= ManualAsset::TYPES[asset.asset_type] %></td><td data-label="Valued on"><%= asset.valued_on %></td><td class="amount" data-label="Your share’s value"><%= money(asset.value, asset.currency) %></td><td><%= link_to "Edit / update value", edit_manual_asset_path(asset), class: "text-button", aria: { label: "Edit asset: #{asset.name}" } %></td></tr><% end %>
<% if @assets.empty? %><tr><td colspan="5" class="empty-state"><h3>No assets to show.</h3><p>Add an asset or reset the filters to see more.</p><%= link_to "Add your first asset", new_manual_asset_path, class: "primary-button" %></td></tr><% end %>
</tbody></table></div></section>
