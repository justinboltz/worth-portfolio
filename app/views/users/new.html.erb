<div class="page-heading"><div><h1>Create your account</h1><p>Your finances, together in one place.</p></div></div>
<%= render "shared/form_errors", record: @user %>

<%= form_with model: @user, url: sign_up_path, class: "stack-form" do |form| %>
  <div class="form-field">
    <%= form.label :email %>
    <%= form.email_field :email, required: true, autofocus: true, autocomplete: "email" %>
  </div>

  <%= render "shared/password_field", form: form, attribute: :password,
        label: "Password", autocomplete: "new-password" %>
  <%= render "shared/password_field", form: form, attribute: :password_confirmation,
        label: "Password confirmation", autocomplete: "new-password" %>

  <div class="form-actions">
    <%= form.submit "Sign up", class: "primary-button" %>
  </div>
<% end %>

<p class="auth-footer">
  Already have an account? <%= link_to "Sign in", sign_in_path %>
</p>
