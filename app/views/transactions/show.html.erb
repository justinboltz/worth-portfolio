<div class="page-heading"><div><p class="eyebrow">TRANSACTION DETAILS</p><h1><%= @transaction.name %></h1><p><%= @transaction.date %> · <%= @transaction.account_label %> · <%= @transaction.source.humanize %></p></div><strong class="spending-total"><%= money(@transaction.amount, @transaction.iso_currency_code) %></strong></div>
<% if @transaction.split_needs_review? %><p class="flash flash-alert">Your bank changed the original amount. Your split edits are preserved, and this transaction is excluded from reports until you update or remove its splits.</p><% end %>
<% if @transaction.duplicate? && @transaction.raw_payload.to_h['import_duplicate_reason'].present? %><p class="flash flash-alert"><strong>Flagged during import:</strong> <%= @transaction.raw_payload['import_duplicate_reason'] %> Compare the existing transaction before clearing the Duplicate flag.</p><% end %>
<div class="inspector-grid"><section class="card padded"><%= render 'form' %></section><section class="card padded"><h2>Split this transaction</h2><p>Use signed amounts in <%= @transaction.iso_currency_code %>. They must equal the original amount exactly. Reports count the children, and inherit the original transaction’s exclusion flags.</p>
<% if @transaction.is_split? %><div class="split-summary"><% @transaction.splits.each do |s| %><p><%= s.name %> · <%= s.category&.display_name || 'Uncategorized' %> <strong><%= money(s.amount, s.iso_currency_code) %></strong></p><% end %><%= button_to 'Remove splits', unsplit_transaction_path(@transaction), method: :delete, class: 'danger-button', form: { data: { turbo_confirm: 'Remove all splits and restore the original transaction? Split descriptions and categories will be removed.' } } %></div><% end %>
<%= render 'split_form' %></section></div><p><%= link_to 'Back to transactions', transactions_path, class: 'text-button' %></p>
