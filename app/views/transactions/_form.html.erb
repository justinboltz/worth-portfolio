<%= form_with model: @transaction, class: 'stack-form' do |f| %>
<%= render 'shared/form_errors', record: @transaction %>
<div class="form-grid"><label>Description<%= f.text_field :name, required: true %></label>
<% if @transaction.new_record? || (@transaction.source_manual? && !@transaction.is_split?) %>
<label>Date<%= f.date_field :date, required: true %></label><label>Amount (positive = spending)<%= f.number_field :amount, step: '0.0001', required: true %></label><label>Currency<%= f.select :iso_currency_code, %w[USD CAD EUR GBP] %></label><label>Source account name<%= f.text_field :source_account_name %></label>
<% end %><label>Category<%= f.select :category_id, @category_options, include_blank: 'Uncategorized' %></label><label>Tags (comma separated)<%= f.text_field :tags %></label><label class="form-field-wide">Notes<%= f.text_area :notes %></label></div>
<div class="flag-options"><label><%= hidden_field_tag 'transaction[lock_category]', '0' %><%= check_box_tag 'transaction[lock_category]', '1', @transaction.category_locked? %> Keep this category (including Uncategorized)</label><label><%= check_box_tag 'transaction[remember_merchant]', '1', false, disabled: @transaction.persisted? && @transaction.merchant_key.blank? %> Remember this category for this merchant</label></div>
<p class="muted"><%= @transaction.category_reason || 'Automatic categories use bank data, your rules and consistent merchant history.' %> Clear “Keep this category” to allow automatic categorization again.</p>
<% if @transaction.category_suggestion_reason.present? %><p class="flash"><%= @transaction.category_suggestion_reason %><% if @transaction.suggested_category %> · Choose <strong><%= @transaction.suggested_category.display_name %></strong> above to accept.<% end %></p><% end %>
<label>Expense type<%= f.select :expense_type, ExpenseClassification::LABELS.map { |value, label| [label, value] }, include_blank: 'Use category default' %></label>
<p class="muted">Used for the fixed and variable spending breakdown. Split transactions inherit this choice unless a split has its own override.</p>
<label>Cash-flow treatment<%= f.select :classification_choice, [['Automatic detection', 'automatic'], ['Regular income / spending', 'regular'], ['Transfer', 'transfer'], ['Credit-card payment', 'card_payment']] %></label>
<% if @transaction.persisted? %><p class="muted"><%= @transaction.classification_reason || 'No automatic exclusion detected.' %><% if @transaction.matched_transaction %> · <%= link_to 'View matching movement', transaction_path(@transaction.matched_transaction) %><% end %></p><% if @transaction.suggested_classification.present? %><p class="flash">Suggested <%= @transaction.suggested_classification.humanize.downcase %>: <%= @transaction.suggestion_reason %>. Still included in reports until confirmed.</p><% end %><% end %>
<div class="flag-options"><% %i[hidden duplicate].each do |flag| %><label><%= f.check_box flag %> <%= flag.to_s.humanize %></label><% end %></div><p class="muted">Hidden, duplicate, transfer, card payment and pending transactions are excluded from spending, income, budgets and Trends.</p><div class="form-actions"><%= f.submit 'Save transaction', class: 'primary-button' %></div><% end %>
