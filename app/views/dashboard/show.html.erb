<div class="page-heading"><div><p class="eyebrow">YOUR MONEY AT A GLANCE</p><h1>Overview</h1><p class="muted">A little clarity for your everyday finances.</p></div><span class="date-label"><%= Date.current.strftime('%B %d, %Y') %></span></div>
<div class="summary-grid">
<section class="card metric"><p><%= @missing_balances.positive? ? 'Known net worth' : 'Current net worth' %></p><% @net_worth.each do |currency, value| %><strong><%= money(value, currency) %></strong><% end %><% if @net_worth.empty? %><strong>--</strong><% end %><small>Bank balances + manual assets − liabilities</small><% if @missing_balances.positive? %><small><%= pluralize(@missing_balances, 'account') %> without a current balance; totals are partial.</small><% end %></section>
<section class="card metric"><p>Spent this month</p><strong><%= money(@spending) %></strong><small><%= @month.strftime('%B') %> to date · USD</small></section>
<section class="card metric"><p>Money in this month</p><strong class="positive"><%= money(@income) %></strong><small>Month to date · USD · excluding transfers</small></section>
</div>
<section class="card padded"><h2>Spending comparison</h2><% max = [@spending, @previous_spending, 1].max %><div class="category-row"><div><span>This month to date</span><strong><%= money(@spending) %></strong></div><progress value="<%= @spending %>" max="<%= max %>" aria-label="This month spending"></progress></div><div class="category-row"><div><span>Previous full month</span><strong><%= money(@previous_spending) %></strong></div><progress value="<%= @previous_spending %>" max="<%= max %>" aria-label="Previous month spending"></progress></div><%= link_to 'Explore Trends', trends_path, class: 'text-button' %></section>
<div class="overview-grid">
<section class="card"><div class="card-heading"><div><h2>Spending this month</h2><p><%= @month.strftime('%B %Y') %></p></div><%= link_to 'View transactions', transactions_path %></div>
<% if @category_spending.any? %><div class="spending-total"><%= money(@spending) %><span>total outflow</span></div><div class="category-bars"><% @category_spending.first(6).each do |name, amount| %><div class="category-row"><div><span><%= name %></span><strong><%= money(amount) %></strong></div><progress value="<%= amount %>" max="<%= @spending %>" aria-label="<%= name %> spending"></progress></div><% end %></div><% else %><div class="empty-state"><h3>A fresh month, a clear picture.</h3><p>Your breakdown will appear as posted transactions arrive.</p></div><% end %><p class="footnote">Flagged transfers, card payments, hidden and duplicate transactions are excluded. USD only.</p>
</section>
<%= render 'connections' %></div>
<section class="card recent-card"><div class="card-heading"><div><h2>Recent transactions</h2><p>The latest activity across your accounts</p></div><%= link_to 'See all', transactions_path %></div><div class="table-scroll"><table class="responsive-table recent-list" role="table" aria-label="Recent transactions"><thead><tr><th scope="col">Date</th><th scope="col">Description</th><th scope="col">Category</th><th scope="col" class="amount">Amount</th></tr></thead><tbody><% @recent_transactions.first(8).each do |transaction| %><tr><td class="muted" data-label="Date"><%= transaction.date.strftime('%b %-d') %></td><td class="transaction-description"><strong><%= link_to transaction.name, transaction_path(transaction.parent || transaction) %></strong><small><%= transaction.account_label %><%= ' · Pending' if transaction.pending? %></small></td><td data-label="Category"><span class="category-tag"><%= transaction.is_split? ? 'Split transaction' : transaction.category&.name || 'Uncategorized' %></span></td><td class="transaction-amount amount <%= 'positive' if transaction.amount.negative? %>"><%= money(transaction.amount, transaction.iso_currency_code) %></td></tr><% end %><% if @recent_transactions.empty? %><tr><td colspan="4" class="empty-state">No transactions yet. Connect an account or import your history.</td></tr><% end %></tbody></table></div></section>
