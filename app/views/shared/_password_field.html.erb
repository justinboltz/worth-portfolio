<div class="form-field">
  <%= form.label attribute, label %>
  <div class="password-input"
       data-controller="password-visibility"
       data-password-visibility-label-value="<%= label.downcase %>"
       data-action="turbo:before-cache@document->password-visibility#hide">
    <%= form.password_field attribute, required: true, autocomplete: autocomplete,
          spellcheck: false, autocapitalize: "off", autocorrect: "off",
          data: { password_visibility_target: "input" } %>
    <button type="button" class="password-toggle" hidden
            aria-controls="<%= form.field_id(attribute) %>"
            aria-label="Show <%= label.downcase %>"
            data-password-visibility-target="button"
            data-action="pointerdown->password-visibility#preserveFocus click->password-visibility#toggle">Show</button>
  </div>
</div>
