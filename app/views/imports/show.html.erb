<div class="page-heading"><div><h1>Review your import</h1><p>1. Map columns → 2. Review categories and duplicates → 3. Import</p></div></div>
<% if @error %><p class="flash flash-alert"><%= @error %></p><% end %>
<%= form_with url: import_path(@batch), method: :patch do %>
<section class="card padded"><h2>Column mapping</h2><div class="form-grid"><% Imports::CsvPreview::ALIASES.each_key do |key| %><label><%= key.humanize %><%= ' *' if %w[date description amount].include?(key) %><%= select_tag "headers[#{key}]", options_for_select(@headers || [], @mapping&.fetch(key, nil)), include_blank: 'Not mapped' %></label><% end %>
<label>Currency<%= select_tag :currency, options_for_select(%w[USD CAD EUR GBP], @batch.settings.fetch('currency', 'USD')) %></label>
<label class="check-option"><%= hidden_field_tag :reverse_sign, '0' %><%= check_box_tag :reverse_sign, '1', @batch.settings['reverse_sign'] == '1' %> Reverse amount signs</label></div><div class="form-actions"><%= submit_tag 'Update preview', class: 'secondary-button', data: { turbo_submits_with: 'Updating preview…' } %></div></section>
<% if @preview %>
<% invalid_count = @preview.rows.count { |row| row[:error] }; skipped_count = @preview.rows.count { |row| row[:existing] }; duplicate_count = @preview.rows.count { |row| !row[:error] && !row[:existing] && (row[:candidates].any? || row[:file_duplicate]) } %>
<% if invalid_count.positive? %><div class="flash flash-alert" role="alert"><strong><%= pluralize(invalid_count, 'row') %> need correction before import.</strong> Review the errors below. Correct the column mapping, or fix your CSV and <%= link_to 'upload it again', new_import_path %>.</div><% elsif @preview.rows.empty? %><div class="flash flash-alert" role="alert">This file has no transaction rows. <%= link_to 'Choose another CSV', new_import_path %>.</div><% end %>
<div class="import-summary" aria-label="Import summary"><span><strong><%= @preview.rows.size - invalid_count - skipped_count - duplicate_count %></strong> ready</span><span><strong><%= duplicate_count %></strong> possible duplicates</span><span><strong><%= skipped_count %></strong> already imported</span></div>
<section class="card padded"><h2>Category mapping</h2><p>Map each source category into an existing category. Unmapped categories stay uncategorized.</p><div class="form-grid"><% @preview.source_categories.each do |name| %><label><%= name %><%= select_tag "categories[#{name}]", options_for_select(@categories.map { |c| [c.display_name, c.id] }, @batch.settings.fetch('categories', {})[name]), include_blank: 'Uncategorized' %></label><% end %></div></section>
<section class="card padded"><h2>Preview · <%= @preview.rows.size %> rows</h2><p>Exact reimports are skipped. Possible duplicates are skipped unless selected; selected duplicates are flagged and excluded from reports until reviewed.</p><div class="table-scroll preview-scroll"><table class="responsive-table" role="table" aria-label="Import preview"><thead><tr><th scope="col">Row</th><th scope="col">Date</th><th scope="col">Description / source account</th><th scope="col">Amount</th><th scope="col">Review</th></tr></thead><tbody><% @preview.rows.each do |row| %><tr><td data-label="Row"><%= row[:number] %></td><% if row[:error] %><td colspan="4" data-label="Error"><%= row[:error] %></td><% else %><td data-label="Date"><%= row[:attrs][:date] %></td><td data-label="Description / source account"><%= row[:attrs][:name] %><small><%= row[:attrs][:source_account_name] %></small></td><td data-label="Amount"><%= money(row[:attrs][:amount], @batch.settings.fetch('currency', 'USD')) %></td><td data-label="Review"><% if row[:existing] %>Already imported — skipped<% elsif row[:candidates].any? || row[:file_duplicate] %><label><%= check_box_tag 'include_duplicates[]', row[:number], false, id: "include_duplicate_row_#{row[:number]}" %> Include flagged duplicate</label><small><%= "Repeated row in this CSV" if row[:file_duplicate] %></small><% row[:candidates].each do |t| %><small><%= t.name %> · <%= t.account_label %></small><% end %><% else %>Ready<% end %></td><% end %></tr><% end %></tbody></table></div>
<div class="import-confirmation"><div class="form-field"><%= label_tag :profile_name, 'Save a reusable mapping as' %><%= text_field_tag :profile_name, nil, placeholder: 'e.g. Mint export' %></div><%= submit_tag 'Confirm import', name: :commit_import, class: 'primary-button', disabled: invalid_count.positive? || @preview.rows.empty?, data: { turbo_submits_with: 'Importing…' } %></div></section>
<% end %><% end %>
