<div class="page-heading"><div><h1>Sign in</h1><p>Welcome back to Worth.</p></div></div>

<%= form_with url: sign_in_path, class: "stack-form" do |form| %>
  <div class="form-field">
    <%= label_tag :email %>
    <%= email_field_tag :email, params[:email], required: true, autofocus: true, autocomplete: "email" %>
  </div>

  <%= render "shared/password_field", form: form, attribute: :password,
        label: "Password", autocomplete: "current-password" %>

  <div class="form-actions">
    <%= form.submit "Sign in", class: "primary-button" %>
  </div>
<% end %>

<p class="auth-footer">
  New here? <%= link_to "Create an account", sign_up_path %>
</p>
